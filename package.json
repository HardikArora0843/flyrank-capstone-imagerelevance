{
  "name": "flyrank-capstone-image-relevance",
  "version": "0.1.0",
  "description": "AI image understanding and content matching backend for FlyRank AI Capstone 3.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node ./node_modules/nodemon/bin/nodemon.js src/server.js",
    "start": "node src/server.js",
    "test": "node ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node ./node_modules/jest/bin/jest.js --watch",
    "seed": "node scripts/seed.js",
    "seed:images": "node scripts/seedImages.js",
    "seed:posts": "node scripts/seedPosts.js",
    "seed:evaluation": "node scripts/seedEvaluation.js",
    "migrate": "node scripts/migration.js",
    "evaluate": "node scripts/evaluate.js",
    "lint": "node ./node_modules/eslint/bin/eslint.js ."
  },
  "keywords": [
    "flyrank",
    "capstone",
    "image-understanding",
    "express",
    "mongodb",
    "gemini"
  ],
  "author": "Hardik Arora",
  "license": "MIT",
  "dependencies": {
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "inngest": "^4.18.1",
    "mongoose": "^9.9.2",
    "multer": "^2.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "clearMocks": true
  }
}
